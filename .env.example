# Postgres
POSTGRES_USER=ccapp
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=auth_db

# Shared JWT secret - must match between auth-service and application-service
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Ports
FRONTEND_PORT=4200
AUTH_PORT=8001
APPLICATION_PORT=8002
DECISION_PORT=8003
DB_PORT=5432
