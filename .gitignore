# ============================================================
# Terraform
# ============================================================
.terraform/

# Terraform state files - NEVER commit
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Terraform variable files - may contain secrets
*.tfvars
*.tfvars.json

# Terraform lock file - KEEP IN GIT
# .terraform.lock.hcl


# ============================================================
# SSH / Private Keys
# ============================================================
*.pem
*.key


# ============================================================
# Kubernetes Secrets
# ============================================================
k8s/*/secret.yaml
monitoring/grafana-admin-secret.yaml


